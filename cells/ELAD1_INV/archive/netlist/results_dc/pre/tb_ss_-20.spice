* inverter pre ss_-20
.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice ss
.include /foss/designs/ELAD-1/cells/ELAD1_INV/netlist/ELAD1_INV.spice
XDUT A Y VDPWR VGND  ELAD1_INV
VG0 VGND 0 0
VDD VDPWR 0 1.8
VIN A 0 0
.option rshunt=1e12
.temp -20
.control
set filetype=ascii
dc VIN 0 1.8 0.005
wrdata results_dc/pre/sweeps/vtc_ss_-20.txt v(Y)
wrdata results_dc/pre/sweeps/idd_ss_-20.txt i(VDD)
quit
.endc
.end
