* tsw bw postRC tt
.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice tt
.include /foss/designs/ELAD-1/cells/ELAD1_TSW/pex_rc/ELAD1_TSW_rc_sub.spice
XDUT A B EN ENB VDPWR VGND  ELAD1_TSW
VDD VDPWR 0 1.8
VG0 VGND 0 0
.option rshunt=1e12
.temp 85
VEN EN 0 1.8
VENB ENB 0 0
VA A 0 dc 0.9 ac 1
CL B 0 1p
.control
ac dec 40 1e6 50e9
meas ac bw when vdb(B)=-3 fall=1
quit
.endc
.end
