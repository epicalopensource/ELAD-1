* TGA ac postC sf_-20
.lib /foss/pdks/sky130A/libs.tech/ngspice/sky130.lib.spice sf
.include /foss/designs/ELAD-1/cells/ELAD1_TGA/netlist/flow/pex/ELAD1_TGA_pex_sub.spice
XDUT A B EN ENB VDPWR VGND  ELAD1_TGA
VDD VDPWR 0 1.8
VG0 VGND 0 0
.option rshunt=1e12
.temp -20
VEN EN 0 1.8
VENB ENB 0 0
VIN A 0 0.9 AC 1
CL B 0 1p
.control
set filetype=ascii
ac dec 40 1e3 1e11
let g = vdb(B)
wrdata results/postC/sweeps/acon_sf_-20.txt g
alter VEN dc=0
alter VENB dc=1.8
ac dec 40 1e3 1e11
let g = vdb(B)
wrdata results/postC/sweeps/acoff_sf_-20.txt g
quit
.endc
.end
