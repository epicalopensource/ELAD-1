C {devices/code_shown.sym} -400 -800 0 0 {name=s1 only_toplevel=false value=".option reltol=1e-6 abstol=1e-15 vntol=1e-8 gmin=1e-15 itl1=500 itl2=500
.control
foreach var 1 2
foreach it 4e-6 10e-6 20e-6
if $var = 1
alter VEPG dc = 1.8
alter VEPC dc = 0
alter VCPG dc = 0
alter VCPC dc = 1.8
else
alter VEPG dc = 0
alter VEPC dc = 1.8
alter VCPG dc = 1.8
alter VCPC dc = 0
end
alter IT dc = $it
op
let isum = -(i(VD3)+i(VD4))
let vbias_pin = v(P0)
if $var = 1
let vd1_int = v(xcore.d1_g)
else
let vd1_int = v(xcore.d1_c)
end
let drop_mv = 1000*(1.2 - vd1_int)
let isum_ratio = isum/$it
echo ROW pairop var=$var itail=$it isum=$&isum isum_ratio=$&isum_ratio vbias_pin=$&vbias_pin drop_mv=$&drop_mv
dc VDIF -0.002 0.002 0.001
let did = i(VD4)-i(VD3)
meas dc vos find v(dif) when did=0
let vos_uv = 1e6*vos
echo ROW pairvos var=$var itail=$it vos_uv=$&vos_uv
end
end
.endc"}
C {sky130_fd_pr/corner.sym} -400 -1000 0 0 {name=CORNER only_toplevel=true corner=tt}
T {tb_top_pair - differential-pair mode through the selector and the TT analog path.
ua0: ITAIL forced into the on-chip tail diode   ua1 / ua2: VCM +/- VDIF/2
ua3 / ua4: drain voltage sources VD3, VD4 (ammeters)
Loop: both pair variants (1 = GROUPED, 2 = CENTROID) x ITAIL 4 / 10 / 20 uA. For each case an
operating point (ROW pairop: isum = total drain current, drop = drain-path voltage drop) and a VDIF sweep of
+/-2 mV in 1 mV steps; ROW pairvos: vos = input offset, the VDIF where the two drain currents are equal.} -400 -1370 0 0 0.4 0.4 {}
