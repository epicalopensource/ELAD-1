C {devices/code_shown.sym} -400 -1060 0 0 {name=s1 only_toplevel=false value=".option reltol=1e-6 abstol=1e-15 vntol=1e-8 gmin=1e-15 itl1=500 itl2=500
.control
foreach var 1 2
if $var = 1
alter VEMG dc = 1.8
alter VEMC dc = 0
alter VCMG dc = 0
alter VCMC dc = 1.8
else
alter VEMG dc = 0
alter VEMC dc = 1.8
alter VCMG dc = 1.8
alter VCMC dc = 0
end
foreach kelv 1 0
foreach ir 2e-6 5e-6 10e-6 20e-6
alter IREF dc = $ir
let vf = 0.65
alter VS4 dc = $&vf
op
if $kelv = 1
let vf = vf + v(P3) - v(P2)
alter VS4 dc = $&vf
op
let vf = vf + v(P3) - v(P2)
alter VS4 dc = $&vf
op
else
let vf = v(P3)
alter VS4 dc = $&vf
op
end
let iout = -i(VS4)
let err_pct = 100*(iout-$ir)/$ir
if $var = 1
let vref_int = v(xcore.ref_g)
let vout_int = v(xcore.out_g)
else
let vref_int = v(xcore.ref_c)
let vout_int = v(xcore.out_c)
end
let dvds_mv = 1000*(vout_int - vref_int)
let vua0 = v(P0)
echo ROW mirror var=$var kelvin=$kelv iref=$ir err_pct=$&err_pct dvds_mv=$&dvds_mv v_ua0=$&vua0
end
end
end
.endc"}
C {sky130_fd_pr/corner.sym} -400 -1260 0 0 {name=CORNER only_toplevel=true corner=tt}
T {tb_top_mirror - current-mirror mode through the selector and the TT analog path.
ua0: IREF (ideal current source, board side)   ua3: REF sense   ua2: OUT Kelvin sense
ua4: SMU voltage VS4. Kelvin on: VS4 is corrected by V(P3)-V(P2) over 3 operating points until
V(P2) = V(P3), i.e. equal VDS inside the macro (what the chip's Kelvin servo does).
Kelvin off: VS4 = V(P3), the unguided baseline. (The package wrote the servo as a 1e5-gain
source inside the circuit; with the full sky130 models that stops the solver at some
points, the relaxation here gives the same result without feedback in the matrix.)
Loop: both mirror variants (1 = GROUPED, 2 = CENTROID) x Kelvin on/off x four IREF values, one
'ROW mirror ...' line per case: err_pct = 100*(IOUT-IREF)/IREF, dvds_mv = VDS(OUT)-VDS(REF)
inside the macro, v_ua0 = voltage the current source needs on ua0 (compliance).} -400 -1730 0 0 0.4 0.4 {}
